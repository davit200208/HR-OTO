APP_ENV=development
APP_NAME=HR-OTO Server
API_PORT=8000
DATABASE_URL=postgresql+psycopg://hr_oto:change_me@localhost:5432/hr_oto
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
SECRET_STORAGE_PROVIDER=environment
JWT_SECRET_KEY=replace_with_a_long_random_secret
BOOTSTRAP_TOKEN=replace_with_a_one_time_owner_bootstrap_secret
# DATABASE_ADMIN_URL is used only for tenant database provisioning.
# DATABASE_ADMIN_URL=postgresql+psycopg://postgres:password@localhost:5432/postgres
# Provider secrets are intentionally omitted. Inject them only at server runtime.

